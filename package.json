{
  "name": "grassagent",
  "version": "0.1.0",
  "description": "极简 AI Agent 骨架：零依赖、可流式、能读写文件与执行命令",
  "type": "module",
  "main": "src/cli.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gggtttfff/GrassAgent.git"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "openai",
    "cli"
  ],
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning e2e-smoke.ts",
    "test:unit": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:all": "npm run typecheck && npm run test:unit && npm test",
    "sandbox:control": "node --disable-warning=ExperimentalWarning src/sandbox/controlServer.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@earendil-works/pi-schema": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "p-limit": "^7.3.3",
    "p-retry": "^8.0.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
