# 环境变量与密钥
.env
.env.*
!.env.example

# 依赖
node_modules/

# 构建产物
dist/
build/
*.tsbuildinfo

# 日志与临时文件
*.log
npm-debug.log*
logs/

# 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# 测试残留
coverage/
.nyc_output/

# 临时提交消息文件(git commit -F 用,提交后删掉)
.commit-msg-*.txt

# 临时验证脚本(写完跑完就删,别进版本库)
scratch-*.ts

# 本地工作记忆。只给这台机器上的助手用,不入库。
.workbuddy/

# 会话导出。里面是对话内容,不要进版本库。
.grass/grassagent-bundle.json
# 工具输出的全文临时文件。可能很大,也不该进版本库。
.grass/tmp/
grassagent-bundle.json
