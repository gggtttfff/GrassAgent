# ---- 必填 ----
GRASSAGENT_API_KEY=
# 主力模型:对话和解决问题。小模型、审批模型不填时继承这一组。
GRASSAGENT_MODEL=deepseek-chat
GRASSAGENT_BASE_URL=https://api.deepseek.com

# ---- 小模型 ----
# 只负责两件事:给会话起标题,以及判断要不要压缩上下文。
# 留空则用上面的主力模型。想省钱可以换成更小的模型,甚至另一个服务。
GRASSAGENT_SMALL_MODEL=
GRASSAGENT_SMALL_BASE_URL=
GRASSAGENT_SMALL_API_KEY=
GRASSAGENT_SMALL_MAX_TOKENS=

# ---- 审批模型 ----
# 写文件、改文件、执行命令之前,由它决定放不放行。读文件不经过它。
# 留空则用主力模型,但 max_tokens 缺省是 512,只够写一行结论。
GRASSAGENT_APPROVAL_MODEL=
GRASSAGENT_APPROVAL_BASE_URL=
GRASSAGENT_APPROVAL_API_KEY=
GRASSAGENT_APPROVAL_MAX_TOKENS=

# ---- 工作区沙箱 ----
# 所有文件读写和命令执行都限制在这个目录内。留空则用进程启动目录。
GRASSAGENT_WORKSPACE=
# run_bash 的命令超时(毫秒)。编译、跑测试通常要超过默认的 3 秒。
GRASSAGENT_COMMAND_TIMEOUT_MS=3000

# ---- 可靠性 ----
# 单次请求最多重试几次(仅对网络错误/429/5xx 生效,4xx 业务错误立即失败)
GRASSAGENT_MAX_RETRIES=3
# 退避起始毫秒,按指数增长并带随机抖动
GRASSAGENT_RETRY_BASE_DELAY_MS=1000
# 退避上限毫秒
GRASSAGENT_RETRY_MAX_DELAY_MS=30000
# 同时在飞的 LLM 请求数上限
GRASSAGENT_MAX_CONCURRENCY=4
# 单次请求超时毫秒
GRASSAGENT_REQUEST_TIMEOUT_MS=120000

# ---- 日志 ----
# fatal/error/warn/info/debug/trace
GRASSAGENT_LOG_LEVEL=info
# json(生产,便于采集) 或 pretty(开发,人眼可读)
GRASSAGENT_LOG_FORMAT=json

# ---- 工具执行 ----
# parallel(默认) 会并发跑互相独立的工具;修改同一文件的操作仍按文件串行。
# sequential 全部串行,遇到竞态时可用它降级排查。
GRASSAGENT_TOOL_EXECUTION=parallel

# ---- 上下文压缩 ----
# 估算 token 超过「窗口 - 预留」就把旧消息总结成摘要。
# 历史不会被删掉,只是发给模型的内容变短了(摘要 + 最近的一段)。
# 本地小模型要把窗口改小,并一起改小预留和保留,否则启动校验会拒绝。
GRASSAGENT_CONTEXT_WINDOW=128000
# 留给回复和摘要的 token。超过窗口减去这个值就开始压。
GRASSAGENT_COMPACT_RESERVE_TOKENS=16384
# 压缩后尽量留下的最近 token。和预留加起来必须小于窗口。
GRASSAGENT_COMPACT_KEEP_RECENT_TOKENS=20000

# ---- 会话存储 ----
# SQLite 数据库文件。多个进程可以同时读写同一个文件,各自的会话互相隔离。
GRASSAGENT_SESSION_DATABASE_PATH=
# 会话 ID。留空则每次启动自动生成,相当于开一个新会话。
# 想接着上次的对话,把它设成上次的 sessionId。
GRASSAGENT_SESSION_ID=

# ---- 钩子 ----
# 钩子配置文件。留空则用工作区下的 .grass/hooks.json,文件不存在就等于没配钩子。
# 显式指定了路径但文件不存在,启动会失败。
GRASSAGENT_HOOKS_PATH=
# 命令钩子的默认超时(毫秒)。单个钩子可以在 JSON 里用 timeoutMs 覆盖。
GRASSAGENT_HOOK_TIMEOUT_MS=10000

# ---- 项目规则 ----
# 启动时识别工作区里 opencode、cursor、claude、kiro 的规则和提示词。
# 0 关闭。关掉后不会把这些文件放进系统提示词。
GRASSAGENT_LOAD_PROJECT_INSTRUCTIONS=1

# ---- 技能 ----
# 启动时扫描工作区里的技能包:.grass/skills、.cursor/skills、.claude/skills、
# .kiro/skills、.opencode/skills 下的 SKILL.md。同名时前面的目录优先。
# 技能正文不进系统提示词,只列名字和描述,模型用 load_skill 取全文。
# 0 关闭。关掉后不注册 load_skill 工具。
GRASSAGENT_LOAD_SKILLS=1

# ---- 技能审批 ----
# 加载技能前要不要人点头。技能正文是仓库里的文本,拿到它就等于让模型按别人的指令做事。
# ask 问一次,输入 y 同意;allow 直接放行;deny 一律不给正文。
# 非交互模式(管道、CI)下没人能回答,按拒绝处理。
GRASSAGENT_APPROVE_SKILLS=ask

# ---- 执行世界 ----
# local: 文件和命令都在本机工作区。remote: 交给控制面上的沙盒,失败不会退回本机。
GRASSAGENT_EXECUTION_WORLD=local
# 沙盒权限模式。read-only 只读;workspace-write 可写工作区;
# danger-full-access 绕过工作区限制。在这里写 danger-full-access 等于你本人授权,
# 会话里再用 /mode 切过去会另外弹一次审批。
GRASSAGENT_SANDBOX_MODE=workspace-write
# 控制面用哪种后端创建沙盒。docker 起容器,ssh 连远程主机,inprocess 只在本机起进程。
GRASSAGENT_SANDBOX_BACKEND=docker
# 控制面的调用方凭据。创建和挂回沙盒要带上它。
# 控制面暴露到网络时必须配,不然谁都能创建沙盒、挂回别人的沙盒。
GRASSAGENT_SANDBOX_CONTROL_TOKEN=
# 控制面地址,只接受本机回环上的服务。远程世界必填。
GRASSAGENT_SANDBOX_CONTROL_URL=
# 沙盒镜像。镜像里要有 bash,以及能跑 daemon 的 Node。远程世界在没有 SandboxId 时必填。
GRASSAGENT_SANDBOX_IMAGE=
# 空闲这么久没有调用就回收沙盒(毫秒)。默认 30 分钟。
GRASSAGENT_SANDBOX_TTL_MS=1800000
# 要放进 /workspace 的仓库。留空则是空工作区。地址里不要写用户名和口令。
GRASSAGENT_SANDBOX_REPO_URL=
# 控制面凭据文件里的引用名。请求体里只有这个名字,没有令牌本身。
GRASSAGENT_SANDBOX_CREDENTIAL_REF=
# 挂回一个 keep 留下的沙盒。卷已经没了就失败,不会新建空目录顶替。
GRASSAGENT_SANDBOX_ID=
GRASSAGENT_SANDBOX_CPU=1
GRASSAGENT_SANDBOX_MEMORY_MB=1024
GRASSAGENT_SANDBOX_DISK_MB=10240
# 出站目标,逗号分隔。留空表示容器没有出站网络。目前装不上白名单时创建会失败。
GRASSAGENT_SANDBOX_NETWORK_ALLOWLIST=
# 1: 回收容器时保留工作区卷。
GRASSAGENT_SANDBOX_KEEP=0

# ---- SSH 后端 ----
# 后端选 ssh 时,控制面用 SSH 连远程主机,起一个 daemon 并开隧道把调用转过去。
# 远程主机需要能跑 Node(daemon 直接跑源码)。
# 远程主机地址和端口。端口不是 22 时填这里。
GRASSAGENT_SANDBOX_SSH_HOST=
GRASSAGENT_SANDBOX_SSH_PORT=22
# 登录远程主机的用户名。
GRASSAGENT_SANDBOX_SSH_USER=
# 私钥文件路径。留空则改用 ssh-agent 或密码认证。
GRASSAGENT_SANDBOX_SSH_KEY_PATH=
# 私钥口令。加密私钥才需要。
GRASSAGENT_SANDBOX_SSH_KEY_PASSPHRASE=
# ssh-agent 的 socket 或命名管道。留空自动探测 SSH_AUTH_SOCK,
# Windows 上再试 OpenSSH 自带的命名管道。
GRASSAGENT_SANDBOX_SSH_AGENT=
# 密码认证的口令。私钥和 agent 都用不上时才需要。
GRASSAGENT_SANDBOX_SSH_PASSWORD=
# known_hosts 文件。留空用 ~/.ssh/known_hosts。主机密钥变化时连接会被拒绝。
GRASSAGENT_SANDBOX_SSH_KNOWN_HOSTS_PATH=
# 远程工作区的真实路径。模型看到的是 /workspace,这里对应远程机器上的目录。
# 留空则用远程用户的 $HOME/grass-workspace。
GRASSAGENT_SANDBOX_SSH_WORKSPACE=
# 远程上放 daemon 源码和沙盒目录的根。默认 /tmp。
GRASSAGENT_SANDBOX_SSH_REMOTE_ROOT=/tmp
# SSH 连接和握手超时(毫秒)。
GRASSAGENT_SANDBOX_SSH_TIMEOUT_MS=30000
# 等远程 daemon 健康的超时(毫秒)。
GRASSAGENT_SANDBOX_SSH_HEALTH_TIMEOUT_MS=30000
# 单次沙盒调用的超时(毫秒)。exec 按命令自己的超时另算。
GRASSAGENT_SANDBOX_SSH_CALL_TIMEOUT_MS=30000
# 远程残留目录至少这么旧才清理。太新可能在别的进程部署中。
GRASSAGENT_SANDBOX_SSH_ORPHAN_AGE_MS=1800000
# 带 keep 标记的沙盒目录保留多久。
GRASSAGENT_SANDBOX_SSH_KEEP_RETENTION_MS=604800000
# SSH 断线后每轮最多重连几次。0 表示关掉重连。
GRASSAGENT_SANDBOX_SSH_RECONNECT_ATTEMPTS=3
# 连续几轮都救不回来,冷却这么久再试。
GRASSAGENT_SANDBOX_SSH_RECONNECT_COOLDOWN_MS=30000

# ---- 技能评估 ----
# 默认关闭。打开后才跑技能评估,而且不注册成模型工具。
GRASSAGENT_SKILL_EVAL=false
# 效果验证卡目录。留空则用 ~/.grassagent/skill-eval,不要指到工作区里。
GRASSAGENT_SKILL_EVAL_DIRECTORY=

# ---- 工作区插件 ----
# .grass/plugins 要先信任。ask 问一次并记在宿主目录;allow 直接登记;deny 一律跳过。
# 即使信任,工作区清单也不能申请 host.exec。
GRASSAGENT_TRUST_PLUGINS=ask
# 信任记录。留空则用 ~/.grassagent/plugin-trust.json,不要指到工作区里。
GRASSAGENT_PLUGIN_TRUST_FILE=

# ---- 云端会话 ----
# facing 是面对用户的会话。cloud 是另一块沙盒上的会话,不带 ask_user。
GRASSAGENT_SESSION_PROFILE=facing
# 云端会话记录。留空则用 ~/.grassagent/cloud-sessions,不要指到工作区里。
GRASSAGENT_CLOUD_SESSION_DIRECTORY=
